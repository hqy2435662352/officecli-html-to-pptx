#!/bin/sh
# Refuse a push that would publish private material anywhere in its range.
#
# This is the check that catches the failure mode that actually happened in this
# repository: a private string committed in one commit and deleted in the next.
# The tip is clean, the working tree is clean, and the leak lives in the history
# between them -- so scanning anything but the pushed range would miss it.
#
# Git passes each ref being pushed on stdin as:
#   <local ref> <local sha> <remote ref> <remote sha>
# A remote sha of all zeroes means the remote ref does not exist yet -- but the
# *repository* does, so what the push publishes is what the push's own remote already
# holds.  The hook asks that remote, because the only other candidate is wrong in the
# direction that matters: `refs/remotes/<name>` is a local cache that can be stale,
# and a cache that still claims a blob the remote has since dropped would excuse it.
#
# Git passes the remote's name and URL as the hook's two arguments:
#   $1 = the remote's name ("origin", "upstream", ...)
#   $2 = the remote's URL or path
#
# Exit codes: 1 is a finding, 3 is "the guard could not run".  Both refuse.

set -eu

# Force UTF-8 for the interpreter below.  See the note in pre-commit: without it,
# CPython on Windows decodes a non-ASCII working directory lossily and the guard
# refuses for a reason that has nothing to do with what is being pushed.
PYTHONUTF8=1
export PYTHONUTF8

remote_name="${1:-}"
remote_url="${2:-}"

root=$(git rev-parse --show-toplevel)
guard="$root/.githooks/private_material_guard.py"

if [ ! -f "$guard" ]; then
    echo "private-material guard refused: no scanner at $guard" >&2
    exit 3
fi

python=""
for candidate in "${PYTHON:-}" "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" python3 python; do
    if [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1; then
        python="$candidate"
        break
    fi
done
if [ -z "$python" ]; then
    echo "private-material guard refused: no python interpreter found" >&2
    exit 3
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # A line ending must not decide which branch is taken.  A trailing carriage
    # return on the remote sha made it fail to match the all-zero pattern, so a new
    # ref was treated as an existing one and the scan was handed a base of "0…0\r"
    # -- an invalid revision, which the guard refuses.  Refusing is the safe answer,
    # but the *reason* would have been line endings rather than content, and the same
    # stray CR on a real sha would refuse every push from a CRLF-speaking producer.
    local_sha=$(printf '%s' "$local_sha" | tr -d '\r')
    remote_sha=$(printf '%s' "$remote_sha" | tr -d '\r')
    # A deleted ref publishes nothing.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    bases=""
    case "$remote_sha" in
        0000000000000000000000000000000000000000)
            # The ref is new, so the remote's own refs are the base -- asked of the
            # remote being pushed to, never read from the local cache.  A stale cache
            # that claims a blob the remote has dropped would excuse a re-published
            # leak, and pushing to a remote that is not `origin` would query the wrong
            # repository entirely.
            if [ -z "$remote_url" ]; then
                echo "private-material guard refused: git passed no remote URL, so what the remote already holds cannot be established" >&2
                exit 3
            fi
            if ! published=$(git ls-remote "$remote_url" 2>/dev/null); then
                echo "private-material guard refused: could not ask $remote_name ($remote_url) which refs it publishes" >&2
                exit 3
            fi
            bases=$(printf '%s\n' "$published" | awk 'NF == 2 {print $1}')
            ;;
        *)
            bases="$remote_sha"
            ;;
    esac
    args=""
    if [ -n "$bases" ]; then
        for base in $bases; do
            args="$args --base $base"
        done
    else
        args="--base $remote_sha"
    fi
    echo "private-material guard: range $remote_sha..$local_sha ($remote_ref)"
    # shellcheck disable=SC2086
    if ! "$python" "$guard" --mode range $args --tip "$local_sha"; then
        status=$?
        [ "$status" -eq 0 ] && status=1
    fi
done

exit "$status"
